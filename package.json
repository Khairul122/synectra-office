{
  "name": "synectra-office",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "start": "pnpm dev",
    "dev": "concurrently --kill-others-on-fail -n server,web \"pnpm --filter @synectra/server dev\" \"node scripts/wait-for-server.mjs && pnpm --filter @synectra/web dev\"",
    "stop": "node scripts/stop-dev.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "architecture": "depcruise apps packages --config .dependency-cruiser.cjs",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "dependency-cruiser": "18.7.2",
    "typescript": "5.9.3"
  }
}
