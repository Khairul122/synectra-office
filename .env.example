APP_HOST=127.0.0.1
APP_PORT=3000
WHATSAPP_OWNER_KEY=replace-with-at-least-16-random-characters
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_USE_FIRESTORE=false
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=synectra-office.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=synectra-office
VITE_FIREBASE_STORAGE_BUCKET=synectra-office.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1024708303598
VITE_FIREBASE_APP_ID=1:1024708303598:web:b72b89f084bfd1b918b1ff
VITE_FIREBASE_MEASUREMENT_ID=G-0KEK1TRLG4
PRIVATE_FILES_ROOT=.local/private
# Opsional: path executable Hermes CLI bila `hermes` tidak ada di PATH
HERMES_BIN=
# Chat Hermes via router model OpenAI-compatible (tanpa tools). Kosongkan key -> parser deterministik lokal.
# Key router profil synectra-office ada di .env profil Hermes dengan nama yang sama.
HERMES_ROUTER_API_KEY=
HERMES_MODEL=ComboHermes
HERMES_MODEL=ComboHermes
# Profil Hermes yang mengerjakan task kanban tanpa assignee (default: synectra-office, Lead Hermes).
HERMES_KANBAN_LEAD=
# Toolset agen Hermes untuk chat bebas & evaluasi karyawan (default tanpa terminal/file).
HERMES_CHAT_TOOLSETS=web,memory,skills,session_search
